# Supabase (frontend — anon key only; never put service_role here)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Edge Function secrets (set via CLI, not Vite):
#   npx supabase secrets set APP_URL=http://localhost:5173
# Production:
#   npx supabase secrets set APP_URL=https://your-alza-flow-domain.com
# Alias also accepted: SITE_URL
# Invite emails redirect to: {APP_URL}/auth/set-password
# Review emails deep-link to: {APP_URL}/transactions/<uuid>
#
# Review email (Resend — server-side only):
#   npx supabase secrets set RESEND_API_KEY=re_xxx
#   npx supabase secrets set RESEND_FROM="ALZA Flow <notifications@your-verified-domain>"
# Domain must be verified in Resend before external delivery will succeed.
# Currently required secrets for notify-transaction-review:
#   APP_URL (present)
#   RESEND_API_KEY (required — not optional for delivery)
#   RESEND_FROM (required for a verified sender)
#
# Also add the same origin under Supabase Dashboard → Authentication → URL Configuration:
#   Site URL (local): http://localhost:5173
#   Redirect URLs:    http://localhost:5173/**
#                     https://your-alza-flow-domain.com/**
